# Salin ke .env untuk menjalankan frontend CEPIRIT (issue #20).
# Backend default jalan di http://localhost:8000 (uvicorn app.main:app --reload --port 8000).
VITE_API_URL=http://localhost:8000

# Opsional: isi hanya bila backend mengaktifkan auth (API_KEY di .env backend).
# Bila backend API_KEY kosong, auth mati dan header X-API-Key tidak dikirim.
# VITE_API_KEY=
